                </div>
                <div>
                  <label class="text-xs font-semibold text-slate-600">{{ t('Title') }}</label>
                  <input v-model="reviewForms[item.id].title" type="text" class="input-base mt-1 w-full" :placeholder="t('Loved the quality')" />

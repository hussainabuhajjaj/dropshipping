                <div>
                  <label class="text-xs font-semibold text-slate-600">{{ t('Review') }}</label>
                  <textarea v-model="reviewForms[item.id].body" rows="3" class="input-base mt-1 w-full" :placeholder="t('Share how the item arrived and fit.')" />
